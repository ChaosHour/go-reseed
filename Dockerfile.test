# Test runner image: the module and its dependencies, ready for `go test`.
# Used by docker-compose.test.yml for both the unit and the integration tests.
FROM golang:1.26

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build ./... && go test -c -tags integration -o /dev/null ./test/integration

CMD ["go", "test", "-race", "-count=1", "./..."]
